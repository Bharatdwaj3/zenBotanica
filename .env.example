# DevOps credentials

GHCR_USERNAME=your_git_username
GHCR_TOKEN=your_ghp_token

# Observability stack credentials — pulled from live cluster secrets

LOKI_USER=your_loki_username
LOKI_PASSWORD=your_loki_password

PROM_USER=your_prometheus_username
PROM_PASSWORD=your_prometheus_password

GRAFANA_ADMIN_USER=your_grafana_username
GRAFANA_ADMIN_PASSWORD=your_grafana_password

# Firebase service account

Fbase_private_key_id=your_firebase_private_key
Fbase_private_key=your_firebase_private_key
Fbase_client_email=your_firebase_client_email
Fbase_client_id=your_firebase_client_id
Fbase_auth_uri=your_firebase_auth_uri
Fbase_token_uri=your_firebase_token_uri
Fbase_auth_provider_x509_cert_url=your_firebase_auth_provider_x509_cert_url
Fbase_client_x509_cert_url=your_firebase_client_x509_cert_url

# ArgoCD admin credentials

ARGOCD_USER=your_argoCD_username
ARGOCD_PASSWORD=your_argoCD_password