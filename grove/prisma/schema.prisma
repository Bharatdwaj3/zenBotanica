generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

enum Genre {
  FLORA
  FAUNA
  FUNGUS
  MINERAL
  ARTIFACT
  HERB
  SEED
  UNKNOWN
}

model specimen {
  id              Int       @id @default(autoincrement())
  title           String
  cultivator          String
  nursery       String
  accessionNumber            String    @unique
  genre           Genre[]
  totalCopies     Int       @default(1)
  availableCopies Int       @default(1)
  coverUrl        String?
  pdfUrl          String?
  description     String?
  addedByUserId   Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  featured        Boolean   @default(false)
  weeklyRead      Boolean   @default(false)
  deletedAt       DateTime?
  cartItems       cart_item[]
  wishlistItems   wishlist_item[]
}
model cart_item {
  id        Int      @id @default(autoincrement())
  userId    Int
  specimenId    Int
  specimen      specimen     @relation(fields: [specimenId], references: [id])
  addedAt   DateTime @default(now())

  @@unique([userId, specimenId])
}

model wishlist_item {
  id        Int      @id @default(autoincrement())
  userId    Int
  specimenId    Int
  specimen      specimen     @relation(fields: [specimenId], references: [id])
  addedAt   DateTime @default(now())

  @@unique([userId, specimenId])
}
