// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init
generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  faculty
  student
}

enum Subject {
  Geography
  Social_Studies
  Computer_Science
  Literature
  History
}

model user {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  username     String?  @unique
  password     String
  role         Role
  refreshToken String?
  avatar       String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  faculty      faculty?
  student      student?
}

model faculty {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  Fname     String
  Lname     String
  age       Int
  gender    String
  Expertise Subject
  userId    Int?      @unique
  user      user?     @relation(fields: [userId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model student {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  Fname     String
  Lname     String
  age       Int
  gender    String
  Subjects  Subject
  userId    Int?      @unique
  user      user?     @relation(fields: [userId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}