// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init
generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  curator
  botanist
  apprentice
  caretaker
  tourist
  farmer
  merchant
}

enum Subject {
  Botany
  Ecology
  Horticulture
  Mycology
  Geology
  Geography
  Social_Studies
  Computer_Science
  Literature
  History
}

model user {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  username     String?  @unique
  password     String
  role         Role
  refreshToken String?
  avatar       String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  botanist      botanist?
  apprentice    apprentice?
  caretaker     caretaker?
  tourist       tourist?
  farmer        farmer?
  merchant      merchant?
}

model botanist {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  Fname     String
  Lname     String
  age       Int
  gender    String
  Expertise Subject
  userId    Int?      @unique
  user      user?     @relation(fields: [userId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model apprentice {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  Fname     String
  Lname     String
  age       Int
  gender    String
  Subjects  Subject
  userId    Int?      @unique
  user      user?     @relation(fields: [userId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}
model caretaker {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  Fname     String
  Lname     String
  age       Int
  gender    String
  userId    Int?      @unique
  user      user?     @relation(fields: [userId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model tourist {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  Fname     String?
  Lname     String?
  userId    Int?      @unique
  user      user?     @relation(fields: [userId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model farmer {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  Fname     String
  Lname     String
  userId    Int?      @unique
  user      user?     @relation(fields: [userId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model merchant {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  Fname     String
  Lname     String
  approved  Boolean   @default(false)
  userId    Int?      @unique
  user      user?     @relation(fields: [userId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}
